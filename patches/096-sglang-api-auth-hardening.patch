+def _sensitive_server_arg_fields() -> frozenset[str]:
+    return frozenset(
+        field.name
+        for field in dataclasses.fields(ServerArgs)
+        if field.metadata.get("sensitive")
+    )
+
+
+def redact_server_args_dict(values: Dict[str, Any]) -> Dict[str, Any]:
+    """Copy a ServerArgs-shaped mapping without credential-bearing fields."""
+    values = dict(values)
+    for field_name in _sensitive_server_arg_fields():
+        values.pop(field_name, None)
+    return values
+
+
+def server_args_to_public_dict(server_args: Any) -> Dict[str, Any]:
+    """Serialize ServerArgs without credential-bearing fields."""
+    return redact_server_args_dict(dataclasses.asdict(server_args))
+
+
+def redact_sensitive_cli_args(argv: List[str]) -> List[str]:
+    """Return argv with values for credential-bearing ServerArgs removed."""
+    sensitive_options = {
+        f"--{name.replace('_', '-')}" for name in _sensitive_server_arg_fields()
+    }
+    result: List[str] = []
+    redact_next = False
+    for arg in argv:
+        if redact_next:
+            result.append("<redacted>")
+            redact_next = False
+            continue
+        matching_option = next(
+            (option for option in sensitive_options if arg.startswith(f"{option}=")),
+            None,
+        )
+        if matching_option:
+            result.append(f"{matching_option}=<redacted>")
+        else:
+            result.append(arg)
+            redact_next = arg in sensitive_options
+    return result
+
+
