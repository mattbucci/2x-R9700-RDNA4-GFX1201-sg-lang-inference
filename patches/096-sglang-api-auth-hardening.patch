+def _require_media_source_enabled(env_name: str, source_kind: str) -> None:
+    if os.getenv(env_name, "1").strip().lower() not in {"1", "true", "yes"}:
+        raise ValueError(f"{source_kind} multimodal inputs are disabled")
+
+
+def _media_source_scheme(value: str) -> str:
+    return urlparse(value.strip()).scheme.lower()
+
+
+def _reject_unsupported_media_scheme(value: str, scheme: str) -> None:
+    _require_media_source_enabled("SGLANG_ALLOW_REMOTE_MEDIA", "Remote URL")
+    raise ValueError(f"Unsupported multimodal URL scheme: {scheme!r}")
+
+
+def _enforce_delegated_media_source_policy(value: Any) -> None:
+    """Guard sources passed to third-party processors that may perform their own I/O."""
+    if isinstance(value, (ImageData, VideoData)):
+        value = value.url
+    if isinstance(value, dict):
+        source_keys = {
+            "url",
+            "path",
+            "uri",
+            "src",
+            "source",
+            "image",
+            "video",
+            "audio",
+            "image_url",
+            "video_url",
+            "audio_url",
+            "image_path",
+            "video_path",
+            "audio_path",
+        }
+        for key, item in value.items():
+            if str(key).lower() in source_keys or isinstance(item, (dict, list, tuple)):
+                _enforce_delegated_media_source_policy(item)
+        return
+    if isinstance(value, (list, tuple)):
+        for item in value:
+            _enforce_delegated_media_source_policy(item)
+        return
+    if not isinstance(value, str):
+        return
+    scheme = _media_source_scheme(value)
+    if scheme == "data":
+        return
+    if scheme in {"http", "https"}:
+        _require_media_source_enabled("SGLANG_ALLOW_REMOTE_MEDIA", "Remote URL")
+    elif scheme and scheme != "file":
+        _reject_unsupported_media_scheme(value, scheme)
+    else:
+        # A delegated processor may interpret any other string as a relative,
+        # absolute, or file:// path. Only explicit data: URIs bypass this gate.
+        _require_media_source_enabled("SGLANG_ALLOW_LOCAL_MEDIA", "Local file")
+
