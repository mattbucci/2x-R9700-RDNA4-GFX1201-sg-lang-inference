diff --git a/python/sglang/kernels/ops/activation/softcap.py b/python/sglang/kernels/ops/activation/softcap.py
index 5d39de6..032819e 100644
--- a/python/sglang/kernels/ops/activation/softcap.py
+++ b/python/sglang/kernels/ops/activation/softcap.py
@@ -86,10 +86,11 @@ def softcap_inplace_logits_kernel(
     row_ptr = full_logits_ptr + row * row_stride
     x = tl.load(row_ptr + offsets, mask=mask)
 
-    # Perform operations in-place
-    x = x / softcapping_value
-    x = libdevice.tanh(x)
-    x = x * softcapping_value
+    # Perform softcapping in FP32 for precision (BF16 tanh is lossy) — RDNA4 patch 027,
+    # relocated here in v0.5.13 (kernel moved out of logits_processor.py).
+    x_fp32 = x.to(tl.float32) / softcapping_value
+    x_fp32 = libdevice.tanh(x_fp32)
+    x = (x_fp32 * softcapping_value).to(x.dtype)
 
     # Store result
     tl.store(row_ptr + offsets, x, mask=mask)
